function(redsand_embed_notices target source_root dependency_share)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Notice target does not exist: ${target}")
    endif()
    if(NOT IS_DIRECTORY "${dependency_share}")
        message(FATAL_ERROR "Dependency copyright directory is missing: ${dependency_share}")
    endif()
    file(GLOB notice_files CONFIGURE_DEPENDS "${source_root}/licenses/*.txt")
    list(APPEND notice_files "${source_root}/LICENSE")
    file(GLOB dependency_notices CONFIGURE_DEPENDS "${dependency_share}/*/copyright")
    list(APPEND notice_files ${dependency_notices})
    list(SORT notice_files)
    set(notice_text "${target} - Third-party copyright and license notices\n\n")
    foreach(notice IN LISTS notice_files)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${notice}")
        file(READ "${notice}" content)
        get_filename_component(notice_name "${notice}" NAME)
        if(notice_name STREQUAL "copyright")
            get_filename_component(notice_parent "${notice}" DIRECTORY)
            get_filename_component(notice_name "${notice_parent}" NAME)
        endif()
        string(APPEND notice_text "===== ${notice_name} =====\n${content}\n\n")
    endforeach()
    set(notice_file "${CMAKE_CURRENT_BINARY_DIR}/${target}-notices.txt")
    set(resource_file "${CMAKE_CURRENT_BINARY_DIR}/${target}-notices.rc")
    file(WRITE "${notice_file}" "${notice_text}")
    file(TO_CMAKE_PATH "${notice_file}" resource_path)
    string(ASCII 34 quote)
    file(WRITE "${resource_file}" "REDSAND_THIRD_PARTY_LICENSES RCDATA ${quote}${resource_path}${quote}\n")
    set_source_files_properties("${resource_file}" PROPERTIES OBJECT_DEPENDS "${notice_file}")
    target_sources("${target}" PRIVATE "${resource_file}")
endfunction()
